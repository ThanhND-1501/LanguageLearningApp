# ==============================================================================
# OpenQuiz AI Architecture Blueprint - Environment Configuration Template
# ==============================================================================

# Application Meta
NEXT_PUBLIC_APP_NAME="LingoPulse AI (OpenQuiz Architecture)"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 1. Google Gemini AI API Key (Multimodal Vision OCR, Topic Expansion, Grammar Feedback, Roleplay)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Azure AI Speech Service (Pronunciation Assessment - Accuracy, Fluency, Completeness, Prosody)
# Gói F0 miễn phí 5 giờ âm thanh/tháng: https://portal.azure.com
AZURE_SPEECH_KEY="your_azure_speech_key_here"
AZURE_SPEECH_REGION="eastus"

# 3. Supabase Database & Auth (Optional - LocalStorage / IndexedDB fallback works out of the box)
# Đăng ký miễn phí tại: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# 4. Optional TTS / Whisper API (Nếu dùng Groq hoặc OpenAI thay cho Web Speech API)
GROQ_API_KEY=""
OPENAI_API_KEY=""
